local function applyVisualESP(obj, col, txt)
    if not obj or obj:FindFirstChild("XenoBillboard") then return end
    local p = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart", true)
    if not p or p.Name:match("Wall") or p.Name:match("Desk") or p.Name:match("Floor") then return end
    
    local hl = Instance.new("Highlight", p)
    hl.Name = "XenoHighlight"; hl.FillColor = col; hl.OutlineColor = Color3.fromRGB(255, 255, 255)
    hl.FillTransparency = 0.4; hl.OutlineTransparency = 0.1; hl.Adornee = p
    
    local bb = Instance.new("BillboardGui", p)
    bb.Name = "XenoBillboard"; bb.Size = UDim2.new(0, 160, 0, 30); bb.AlwaysOnTop = true; bb.StudsOffset = Vector3.zero; bb.Adornee = p
    
    local lb = Instance.new("TextLabel", bb)
    lb.Size = UDim2.new(1, 0, 1, 0); lb.BackgroundTransparency = 1; lb.Text = txt; lb.TextColor3 = col; lb.TextSize = 14; lb.Font = Enum.Font.SourceSansBold; lb.TextStrokeTransparency = 0.2
    lb.TextXAlignment = Enum.TextXAlignment.Center; lb.TextYAlignment = Enum.TextYAlignment.Center; lb.Parent = bb
end

local function checkObjectESP(child)
    if not _G.AmbushState.MasterESP then return end
    
    if _G.AmbushState.ESP_Doors and child.Name == "Door" and child:IsA("Model") then 
        local dT = child:FindFirstChild("Door") or child:FindFirstChildOfClass("BasePart")
        if dT then applyVisualESP(dT, _G.AmbushState.Color_Doors, "Door") end
    end
    if _G.AmbushState.ESP_Keys and (child.Name == "Key" or child.Name == "KeyModel" or child.Name == "LiveHintBook") then 
        local espText = (child.Name == "LiveHintBook") and "Book" or "Key"
        applyVisualESP(child, _G.AmbushState.Color_Keys, espText) 
    end
    if _G.AmbushState.ESP_Levers and (child.Name == "LeverForGate" or child.Name == "LeverSwitch") then 
        applyVisualESP(child, _G.AmbushState.Color_Levers, "Lever") 
    end
    
    -- ПРОСТОЙ КЛАССИЧЕСКИЙ ДЕТЕКТ МОНСТРОВ НА МОДЕЛЬ ЦЕЛИКОМ (БЕЗ КОСТЕЙ И КОНЕЧНОСТЕЙ)
    if _G.AmbushState.ESP_Monsters and child:IsA("Model") then
        if child.Name == "RushMoving" then applyVisualESP(child, _G.AmbushState.Color_Monsters, "RUSH")
        elseif child.Name == "AmbushMoving" then applyVisualESP(child, _G.AmbushState.Color_Monsters, "AMBUSH")
        elseif child.Name == "SeekMoving" or child.Name == "Seek" then applyVisualESP(child, _G.AmbushState.Color_Monsters, "SEEK")
        elseif child.Name == "FigureModels" or child.Name == "Figure" or child.Name == "FigureModel" then applyVisualESP(child, _G.AmbushState.Color_Monsters, "FIGURE")
        end
    end
end

W.DescendantAdded:Connect(function(child) 
    task.wait(0.05)
    if _G.AmbushState.ESP_Monsters then
        if child.Name == "RushMoving" then _G.ShowAmbushNotification("Rush spawned!")
        elseif child.Name == "AmbushMoving" then _G.ShowAmbushNotification("Ambush spawned!") 
        end
    end
    checkObjectESP(child) 
end)

task.spawn(function()
    while task.wait(6.0) do
        if not _G.AmbushState.MasterESP then
            for _, o in pairs(W:GetDescendants()) do if o.Name == "XenoHighlight" or o.Name == "XenoBillboard" then o:Destroy() end end
        else
            for _, child in pairs(W:GetDescendants()) do checkObjectESP(child) end
        end
    end
end)

