RS.Heartbeat:Connect(function()
    local Ch = LP.Character; local HRP = Ch and Ch:FindFirstChild("HumanoidRootPart"); local Hum = Ch and Ch:FindFirstChildOfClass("Humanoid")
    if not HRP or not Hum then return end
    if _G.AmbushState.SpeedHack then
        Hum.WalkSpeed = 0
        if Hum.MoveDirection.Magnitude > 0 and not _G.AmbushState.Fly then 
            local finalSpeed = _G.AmbushState.WalkSpeedValue
            local isFigureRoom = W:FindFirstChild("FigureModels") or W:FindFirstChild("Figure") or W:FindFirstChild("FigureModel")
            if isFigureRoom then finalSpeed = math.min(finalSpeed, 30) end
            HRP.CFrame = HRP.CFrame + (Hum.MoveDirection.Unit * (finalSpeed * (1/60))) 
        end
    else
        if not _G.AmbushState.Fly then Hum.WalkSpeed = 16 end
    end
end)

RS.Stepped:Connect(function()
    local Ch = LP.Character; local HRP = Ch and Ch:FindFirstChild("HumanoidRootPart"); local Cam = W.CurrentCamera; if not HRP or not Ch then return end
    if _G.AmbushState.Noclip then for _, p in pairs(Ch:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide = false end end end
    if _G.AmbushState.FullBright then Ltg.Ambient = Color3.fromRGB(255, 255, 255); Ltg.OutdoorAmbient = Color3.fromRGB(255, 255, 255); Ltg.Brightness = 1.5 end
    if _G.AmbushState.Fly then
        HRP.Velocity = Vector3.zero; local dir = Vector3.zero
        if UIS:IsKeyDown(Enum.KeyCode.W) then dir = dir + Cam.CFrame.LookVector end; if UIS:IsKeyDown(Enum.KeyCode.S) then dir = dir - Cam.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.A) then dir = dir - Cam.CFrame.RightVector end; if UIS:IsKeyDown(Enum.KeyCode.D) then dir = dir + Cam.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0,1,0) end; if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then dir = dir - Vector3.new(0,1,0) end
        if dir.Magnitude > 0 then HRP.CFrame = HRP.CFrame + (dir.Unit * (_G.AmbushState.FlySpeedValue / 45)) end
    end
end)
