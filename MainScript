            -- ЖЕСТКИЙ ФИКС: Если меню закрыто, мы полностью отключаем Modal, освобождая камеру
            if not _G.AmbushState.Visible then
                UIS.ModalEnabled = false
                game:GetService("GuiService").SelectedObject = nil
            else
                UIS.ModalEnabled = true
            end
        end
    elseif input.KeyCode == Enum.KeyCode.RightControl then
        _G.AmbushState.SpeedHack = false; _G.AmbushState.Noclip = false; _G.AmbushState.Fly = false; _G.AmbushState.MasterESP = false; _G.AmbushState.FullBright = false
        if _G.MG then _G.MG:Destroy() end
        UIS.ModalEnabled = false
        if _G.ShowAmbushNotification then _G.ShowAmbushNotification("Ambush Hub Terminated!") end
    end
end)
